# syntax=docker/dockerfile:1
# The shared agent image: everything an agent's RUNTIME needs, and nothing the
# engine needs. Node and the `pi` CLI, the tools an agent runs (`secret-exec`,
# `playwright-cli`), the tool-bridge extension, and the small host that starts
# the runtime when the engine asks.
#
# What is deliberately absent is the engine: no gateway libraries, no store, no
# scheduler, no chat SDK. An agent's container holds that agent's profile, that
# agent's session files and that agent's credentials — nobody else's — and the
# engine's dependency set is not something it should be able to import, let
# alone the engine's `.env`.
#
# Per-agent images are built FROM this one: `impi agent sync` writes a small
# Dockerfile per agent carrying whatever that agent asked for. This is the base
# they share, so N agents cost one build of everything below.

# Base images pinned by manifest-list digest: a tag moves, a digest does not.
# To bump: `skopeo inspect --raw docker://<image:tag> | sha256sum` and paste
# the digest here (the same three in Dockerfile.agent and Dockerfile.ward).
FROM docker.io/library/node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS node

FROM docker.io/library/python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed

COPY --from=ghcr.io/astral-sh/uv:0.11@sha256:77280f2f771df71f90786c314fe1bbc1e023feac652969bbf139c280babf2eb7 /uv /uvx /usr/local/bin/
COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates procps \
      ripgrep \
 && rm -rf /var/lib/apt/lists/*

# The runtime itself and the browser tool, from the SAME lockfile the engine's
# image installs from: the two speak one protocol per release, and a skew here
# is the kind of fault that looks like a model problem.
# fd for pi's `find` tool, from its release rather than Debian: bookworm ships
# 8.6, and pi passes flags (`--no-require-git`) that arrived later, so its
# `find` failed on every call. Pinned by version and checksum; pi would
# download it itself, but PI_OFFLINE forbids that, and a binary fetched at run
# time is not one the image vouches for.
ARG FD_VERSION=10.5.0
ARG FD_SHA256_AMD64=761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7
ARG FD_SHA256_ARM64=d76c4317f7d5dba69f8a2a15856c90c777e7f0dd4e85f0de8c76de6992c374d4
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) arch=x86_64; sum="$FD_SHA256_AMD64" ;; \
      arm64) arch=aarch64; sum="$FD_SHA256_ARM64" ;; \
      *) echo "no fd build pinned for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    name="fd-v${FD_VERSION}-${arch}-unknown-linux-musl"; \
    python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], "/tmp/fd.tgz")' \
      "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/${name}.tar.gz"; \
    echo "${sum}  /tmp/fd.tgz" | sha256sum -c -; \
    tar -xzf /tmp/fd.tgz -C /tmp "${name}/fd"; \
    install -m 0755 "/tmp/${name}/fd" /usr/local/bin/fd; \
    rm -rf /tmp/fd.tgz "/tmp/${name}"

# The pi coding agent and the browser tool, from a lockfile: deploy/pi/package.json
# pins the versions, package-lock.json pins every dependency with its integrity
# hash, and `npm ci` refuses a mismatch between the two. Install scripts are
# not run — neither package needs them, and a package that did would be
# running code at build time that nobody reviewed. Telemetry is answered
# here, once, for the install and for every run. Bump: edit the version in
# deploy/pi/package.json, then `make pi-lock`, then rebuild.
ENV PI_TELEMETRY=0
COPY deploy/pi/package.json deploy/pi/package-lock.json /opt/pi/
RUN cd /opt/pi \
 && npm ci --ignore-scripts --omit=dev --no-audit --no-fund \
 && npm cache clean --force \
 && ln -s /opt/pi/node_modules/.bin/pi /usr/local/bin/pi \
 && ln -s /opt/pi/node_modules/.bin/playwright-cli /usr/local/bin/playwright-cli

ARG IMPI_UID=1000
ARG IMPI_GID=1000
RUN set -eu; \
    getent group "${IMPI_GID}" >/dev/null || groupadd -g "${IMPI_GID}" impi; \
    getent passwd "${IMPI_UID}" >/dev/null \
      || useradd -M -u "${IMPI_UID}" -g "${IMPI_GID}" -d /home/impi -s /bin/bash impi

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/local/bin/python3.13 \
    UV_PYTHON_DOWNLOADS=never

# Two packages only: the host, and the secret tool the agent runs. Naming them
# is what keeps the engine and the broker out of this image — the lock covers
# the whole workspace, so every manifest has to be here, but no other code is.
COPY pyproject.toml uv.lock .python-version ./
COPY packages/runtime-relay/pyproject.toml packages/runtime-relay/
COPY packages/wardline/pyproject.toml packages/wardline/
COPY packages/crucible/pyproject.toml packages/crucible/
COPY packages/impi/pyproject.toml packages/impi/
COPY packages/ward/pyproject.toml packages/ward/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace \
        --package runtime-relay --package wardline
COPY packages/runtime-relay/ packages/runtime-relay/
COPY packages/wardline/ packages/wardline/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package runtime-relay --package wardline

# The engine's tool bridge: the client half of the tool-server contract, loaded
# into every runtime this host starts. It ships with the driver rather than with
# the agent, which is why it is copied out of the library rather than installed.
# Beside it the fallback extension, loaded every time and inert unless the
# engine names fallback models for the agent.
COPY packages/crucible/src/crucible/runtimes/pi/extension/ /app/extension/
# The launcher that confines each runtime process with Landlock before it
# starts. One file, standard library only — the engine's own, copied for the
# same reason as the bridge: this image carries no engine library.
COPY packages/crucible/src/crucible/confinement/launcher.py /app/confinement/launcher.py

# Container-fixed paths; the content arrives on volumes. The mounts that are
# shared with the engine are at the SAME paths there — a filename means the same
# thing on both sides, which is what lets an agent send a file it just wrote.
ENV PATH=/app/.venv/bin:$PATH \
    HOME=/home/impi \
    RUNTIME_RELAY_PROFILE_DIR=/app/agents \
    RUNTIME_RELAY_LIBRARY_DIR=/app/skills \
    RUNTIME_RELAY_SESSION_DIR=/app/sessions \
    RUNTIME_RELAY_EXTENSIONS=/app/extension/index.ts:/app/extension/fallback.ts \
    RUNTIME_RELAY_LAUNCHER=/app/confinement/launcher.py \
    RUNTIME_RELAY_WORK_DIR=/tmp/runtime-relay
RUN mkdir -p /app/agents /app/skills /app/sessions /app/files /home/impi/.pi \
 && chown -R "${IMPI_UID}:${IMPI_GID}" /app /home/impi

USER ${IMPI_UID}:${IMPI_GID}
CMD ["runtime-relay", "serve"]
