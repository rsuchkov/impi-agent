# The browser the agents drive: real Chrome, headless, behind the relay that
# starts it on demand and stops it when nothing is connected.
#
# The relay is a static binary, so the runtime image needs no language runtime at
# all — just Chrome and its libraries. Nothing here is shared with the engine's
# image: a web page is untrusted code and this is the container that parses it.
FROM golang:1.25-trixie@sha256:c083e42786e39fb1a7dd4ae5ab02f5d80c3beb3224848ca0fa89f4a063a4ba29 AS relay-build
WORKDIR /src
COPY packages/browser-relay/ ./
# The operator has no Go toolchain and these tests have no CI of their own, so
# the build is where a broken relay has to fail — before an agent's turn finds
# out. (-race needs cgo; that stays a local `make relay-test`.)
RUN go vet ./... && go test ./...
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/relay .

# Docker Official Image, pinned by manifest-list digest (trixie-slim).
# Debian is required to install Google's .deb.
FROM debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258 AS main

# Deliberately unpinned, which is the opposite of what the base images above do.
#
# Google's stable repository carries exactly one version — the current one — and
# a new stable lands about every four weeks. A pin therefore resolves for two or
# three weeks and then fails every build that follows, which for an operator is
# not a slightly-wrong version but an install that does not complete. It also
# would not buy what pinning is for: two people installing the same impi release
# a month apart cannot get the same Chrome from this source, because the older
# one is simply gone.
#
# What actually lands is recorded: `google-chrome --version` at the end of this
# step prints it into the build log. Set CHROME_VERSION (via
# IMPI_BROWSER_CHROME_VERSION) to pin on purpose — to reproduce a bug — knowing
# it will stop resolving.
ARG CHROME_VERSION=

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Google's signing key goes to a dedicated keyring referenced by signed-by=,
# so this key can only ever validate this one repository.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
        | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg; \
    chmod 0644 /etc/apt/keyrings/google-chrome.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
        > /etc/apt/sources.list.d/google-chrome.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        "google-chrome-stable${CHROME_VERSION:+=${CHROME_VERSION}}" \
        fonts-noto-color-emoji \
        fonts-noto-cjk \
      || { \
        echo "Could not install google-chrome-stable${CHROME_VERSION:+=${CHROME_VERSION}}."; \
        echo "If a version is named above: Google's repository carries only the"; \
        echo "current one, so that pin has expired. Clear"; \
        echo "IMPI_BROWSER_CHROME_VERSION in compose.env to take current stable."; \
        exit 1; \
      }; \
    apt-get purge -y --auto-remove curl gnupg; \
    rm -rf /var/lib/apt/lists/*; \
    google-chrome --version

# A high, unprivileged id that collides with nothing in the base image.
RUN groupadd --gid 10001 chrome \
    && useradd --uid 10001 --gid chrome --create-home --shell /bin/bash chrome \
    && mkdir -p /profile \
    && chown chrome:chrome /profile

COPY --from=relay-build /out/relay /usr/local/bin/relay
COPY --chown=root:root packages/browser-relay/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/relay

ENV CDP_PORT=9222 \
    CHROME_INTERNAL_PORT=9223 \
    CHROME_PROFILE_DIR=/profile \
    CHROME_WINDOW_SIZE=1440,900 \
    CHROME_IDLE_TIMEOUT=5m

USER chrome
WORKDIR /profile
EXPOSE 9222

# Probes the relay's own endpoint. Hitting /json/version instead would start
# Chrome on every check and the container would never be idle.
# Shell form so CDP_PORT is expanded; the exec form would pin the default port
# even when the relay was told to listen elsewhere.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/relay -healthcheck -listen "0.0.0.0:${CDP_PORT}"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
