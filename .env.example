# Copy to .env and fill in. The real .env is git-ignored — never commit secrets.

# LLM endpoint (OpenAI-compatible). Consumed by the pi provider extension, not by
# Python directly — pi talks to the model; the bot only forwards these into pi's env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Default pi provider/model for agents whose agent.yaml omits them (empty = let pi
# use its own ~/.pi/agent/settings.json default). provider = pi backend (--provider,
# e.g. openai-codex); model = the model on it (--model).
DEFAULT_PROVIDER=
DEFAULT_MODEL=
# Models every agent moves on to, in order, when its own is overloaded, failing or
# unreachable (CSV of provider/model; not on a spent quota or a refused key). An
# agent's runtime.fallback_models replaces it; AGENTS_FALLBACK_MODELS__<AGENT> too.
DEFAULT_FALLBACK_MODELS=
# Engine's own `support` agent — override its provider/model (falls back to DEFAULT_*).
SUPPORT_PROVIDER=
SUPPORT_MODEL=

# Mattermost gateway (bot account + personal access token).
MATTERMOST_URL=http://localhost:8065
MATTERMOST_TOKEN=

# Which chat gateway agents run on: "mattermost" (default), "slack" or "ws".
# Per-agent override: AGENTS_GATEWAY__<AGENT>=slack. Kinds mix freely.
GATEWAY=mattermost

# ws gateway — a WebSocket hub for YOUR OWN client services (docs/ws-gateway.md).
# Started only when some agent has AGENTS_GATEWAY__<AGENT>=ws. Register services
# with `impi ws add-service <name>`:
#   WS_SERVICE_TOKEN__<NAME>=<secret>       # the service's bearer token
#   WS_SERVICE_AGENTS__<NAME>=a,b           # optional allowlist; unset = all ws agents
# WS_HOST=0.0.0.0
# WS_PORT=8424

# http gateway — a request/turn API for programs that cannot hold a socket.
# Started only when some agent has AGENTS_GATEWAY__<AGENT>=http. Register callers
# with `impi http add-caller <name>`:
#   HTTP_CALLER_TOKEN__<NAME>=<secret>      # the program's bearer token
#   HTTP_CALLER_AGENTS__<NAME>=a,b          # optional allowlist; unset = all http agents
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8428
# HTTP_MAX_WAIT_S=8          # the longest a poll may wait for new events
# HTTP_DRAIN_S=20            # on shutdown, let running turns finish this long

# Slack gateway (Socket Mode). Used by agents with GATEWAY=slack; create a Slack
# app with Socket Mode enabled + a bot user, then:
#   SLACK_BOT_TOKEN=xoxb-...   (Bot User OAuth token)
#   SLACK_APP_TOKEN=xapp-...   (App-Level token, scope connections:write)
# These apply to the default agent (AGENT_NAME); per-agent, use
#   AGENTS_SLACK_BOT_TOKEN__<AGENT>= / AGENTS_SLACK_APP_TOKEN__<AGENT>=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Message shortcuts starting with this prefix are commands (docs/commands.md);
# the rest of the callback id is the command name. Empty = every shortcut is one.
# SLACK_COMMAND_PREFIX=crux_

# Shared skill library (docs/skills.md): a directory of skills any agent can be
# given, ideally its own git repo. Empty = _skills beside AGENTS_PATH.
# SKILLS_PATH=
# Trigger word of the in-chat library browser; the platform's slash command
# must use this exact word.
# SKILLS_COMMAND=skills

# Scheduled and recurring work (docs/tasks.md). Off = no ticker and no agent is
# offered the scheduling tools. The container runs in UTC, so set the zone your
# schedules are written in — "0 9 * * 1-5" means 09:00 there.
# SCHEDULER_ENABLED=true
# SCHEDULER_TIMEZONE=UTC
# TICK_S is a ceiling, not a step: the ticker wakes for a task at its own time
# and waits at most this long when nothing is coming.
# SCHEDULER_TICK_S=20
# SCHEDULER_MAX_CONCURRENT=2
# SCHEDULER_RUN_DEADLINE_S=900
# SCHEDULER_MAX_FAILURES=5
# Trigger word of the in-chat task browser (same rule as SKILLS_COMMAND).
# TASKS_COMMAND=tasks

# Where the inventory lives — conversations, scheduled tasks and their history,
# approvals, pending forms, the agent registry. Three keys: what KIND of
# database, WHICH one, and WHERE the server is. DB_NAME is a file path on
# sqlite and a database name on mongo; DB_URL is unused on sqlite and required
# on mongo, and carries anything else that backend needs (replica set, TLS,
# credentials). Defaults are a file under DATA_DIR, so nothing here is needed
# to run. This does NOT move what agents remember — see docs/storage.md.
# STORE_BACKEND=sqlite
# DB_NAME=
# DB_URL=
# On mongo, a prefix for every collection name when the database is shared
# with another engine or an application's own collections. Set it before the
# first start; empty keeps the plain names.
# DB_COLLECTION_PREFIX=

# Path to the pi CLI binary (@earendil-works/pi-coding-agent). Assumed on PATH.
PI_BIN=pi

# What an agent's process inherits from the engine's environment beside the base
# set (PATH, HOME, locale, proxies, certificate bundles, PI_*): names, CSV, or a
# family PREFIX_* (a prefix of three characters or more, never the engine's own:
# AGENTS_, TOOL_, LLM_, ...). The compose overlays declare theirs under
# RUNTIME_ENV__<AXIS> keys (BROWSER_CDP_URL, SECRET_BROKER_*); this one is for
# anything you add yourself. The value must be in the engine's process
# environment (a compose `environment:` entry, a compose.d/ drop-in) — a line
# in this file does not reach an agent. Per agent: `runtime.env` in agent.yaml,
# or AGENTS_ENV__<AGENT>.
# RUNTIME_ENV=

# How far an agent's runtime process is confined (Landlock): conversation,
# agent or off. A confined process writes only its own files, memory and
# scratch space. Per agent: runtime.confinement in agent.yaml, or
# AGENTS_CONFINEMENT__<AGENT>.
# RUNTIME_CONFINEMENT=conversation

# Which AGENTS_PATH/_extensions/<name>/index.ts load into every agent's runtime
# (CSV of directory names). Nothing loads for merely being present.
# RUNTIME_EXTENSIONS=

# Where your agents live: a directory holding agents/<name>/agent.yaml + .pi/.
# A plain directory (may be a git repo, but nothing requires it).
AGENTS_PATH=
# Which agents to run (CSV of names); empty = all found in AGENTS_PATH.
# AGENTS_ENABLED=

# Per-agent bot tokens (multi-agent). One per agent, keyed by upper-cased name:
#   AGENTS_MM_TOKEN__ASSISTANT=...
#   AGENTS_MM_TOKEN__DEVELOPER=...
# The default agent (AGENT_NAME) falls back to MATTERMOST_TOKEN if unset.
#
# The engine's own `support` agent (builds/maintains agents) ships with impi and
# is present ONLY if its token is set — create a `support` bot in Mattermost and:
#   AGENTS_MM_TOKEN__SUPPORT=...

# Per-agent skills override (CSV of skill names). When set, replaces that agent's
# agent.yaml skills; empty = no skills; unset = use agent.yaml. Handy for the
# bundled support agent (agent-builder, skill-authoring):
#   AGENTS_SKILLS__SUPPORT=agent-builder,skill-authoring

# Dev tuning: reap idle pi subprocesses faster so they don't linger (default 1800).
# A full pool drops its longest-unused idle subprocess for a new turn on its own
# (PI_EVICT_IDLE_ON_PRESSURE=true); PI_ACQUIRE_TIMEOUT_S (120) is how long a turn
# waits when even that finds nothing to drop.
PI_SESSION_IDLE_TTL=300
# Forget, at startup, every conversation idle for this many days (its record and
# the runtime's files). 0 = never: memory is kept until deleted.
# SESSION_RETENTION_DAYS=0

# Agent containers (docs/agent-containers.md). Off by default: every agent's
# runtime is a child of the engine. On, the engine asks each agent's own host
# for one instead, and the agents hold nothing of each other's.
#
# These are WRITTEN BY `impi agent sync` in a container deployment — set them by
# hand only when running the engine outside one.
# AGENT_HOSTS_ENABLED=false
# AGENT_HOST_URL=http://agent-{agent}:8428
# One per agent, keyed by upper-cased name; without one, that agent runs in the
# engine whatever the URL would be:
#   AGENTS_HOST_TOKEN__ASSISTANT=...
#
# And the tool server stops being on the agents' own loopback:
# TOOL_SERVER_HOST=0.0.0.0
# TOOL_PUBLIC_URL=http://impi:8422

# Human owner auto-added to private channels agents create (blank = disabled).
TOOL_CREATE_CHANNEL_OWNER_USERNAME=

# Slash commands (docs/commands.md). Register the platform command with
#   {INTEGRATIONS_PUBLIC_URL}/{INTEGRATIONS_SECRET}/command/<agent>
# and paste the token it issues here (CSV — one per command). No tokens = the
# agent refuses every command. Slack uses crux_* message shortcuts instead.
#   AGENTS_COMMAND_TOKENS__<AGENT>=token1,token2
# With one agent (or a default named by AGENT_NAME), register the command with
#   {INTEGRATIONS_PUBLIC_URL}/{INTEGRATIONS_SECRET}/command/default
# and put its token in the unsuffixed key instead — no agent name anywhere.
#   COMMAND_TOKENS=token1,token2

# Agent provisioning (`impi agent add` CLI + the support agent's create_agent
# tool). A Mattermost SYSTEM-ADMIN personal access token enables automatic bot
# creation; without it you paste each bot's token by hand.
TOOL_CREATE_AGENT_ADMIN_TOKEN=
# Team new bots join (empty = the server's first team).
TOOL_CREATE_AGENT_TEAM=

# Widget callbacks: the receiver binds 0.0.0.0; a containerized Mattermost calls
# back to INTEGRATIONS_PUBLIC_URL. Default http://host.containers.internal:{port};
# if that isn't routable, set "auto" (the engine detects the host LAN IP at
# startup) or a fixed http://IP:port — and keep that subnet in Mattermost's
# AllowedUntrustedInternalConnections. UI_TIMEOUT is the blocking confirm/select
# window before default-reject.
INTEGRATIONS_PORT=8423
# INTEGRATIONS_PUBLIC_URL=auto
# A segment of every callback path; the receiver answers 403 off it. Minted into
# this file on the first start; at least 16 of [A-Za-z0-9_-]. Changing it means
# re-registering every slash command (`impi doctor` prints the URL).
# INTEGRATIONS_SECRET=
# INTEGRATIONS_UI_TIMEOUT=90

# The message under a reply that says what tools the turn ran, with their
# arguments and timings — never their results. Needs interactivity above.
# Traces older than the retention are dropped at startup; 0 keeps them all.
# TOOL_TRACE_ENABLED=true
# TOOL_TRACE_RETENTION_DAYS=14

# A tool that declares a confirmation is asked about before it runs — enforced
# by the engine, not only by the runtime, so a call that reaches the tool
# server directly is gated too. A human can answer "for a while"; this caps
# how long. 0 = ask every single time.
# TOOL_MAX_GRANT_S=900
# Who may answer a tool's confirmation card (CSV of platform user ids). Empty =
# the person whose message started the turn.
# TOOL_APPROVERS=

# Secrets are NOT configured here. A store your agents can use but never read is
# a tool beside the engine, not part of it: the broker runs in its own container,
# `secret-exec` and `ward-admin` are its clients, and they read their two
# settings — where to ask, and where the identities are mounted — straight from
# the container's environment, which the compose overlay declares. Nothing in
# this file would reach them. See docs/secrets.md.
