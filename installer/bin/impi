#!/usr/bin/env bash
# impi — host wrapper around the compose deployment ( ~/.local/bin/impi ).
# The engine and the in-container `impi` CLI live in the container; this
# wrapper finds the installation, assembles the compose invocation, and adds
# the lifecycle verbs: status/logs/start/stop/restart/agent/login/update/
# doctor/uninstall/version. bash 3.2 compatible.

set -euo pipefail

# --- find the installation -----------------------------------------------------

IMPI_HOME="${IMPI_HOME:-$HOME/.impi}"
[ -f "$IMPI_HOME/compose.env" ] || {
    printf '✘ no impi installation at %s (set IMPI_HOME?)\n' "$IMPI_HOME" >&2
    exit 1
}

# compose.env is plain KEY=VALUE (written by the installer) — safe to source.
# shellcheck source=/dev/null
. "$IMPI_HOME/compose.env"

REPO="$IMPI_HOME/repo"
ok()  { printf '✔ %s\n' "$*"; }
bad() { printf '✘ %s\n' "$*" >&2; }
die() { bad "$*"; exit 1; }

# The engine's compose files, the drop-in directory and compose() itself come
# from the installed repo — ONE definition, so the wrapper and the installer can
# never disagree about which files a deployment runs. (die is defined above; the
# library calls it.)
# shellcheck source=../lib/compose.sh
. "$REPO/installer/lib/compose.sh"
# shellcheck source=../lib/files.sh
. "$REPO/installer/lib/files.sh"

env_set() { # KEY VALUE FILE — truncate-in-place (inode survives mounts)
    local key=$1 value=$2 file=$3 tmp="${3}.tmp.$$"
    case "$value" in
        *[![:alnum:]_@%+=:,./-]*)  # quote for bash-sourceability
            value=$(printf '%s' "$value" | sed -e 's/[\\"$`]/\\&/g')
            value="\"$value\""
            ;;
    esac
    [ -e "$file" ] || { : >"$file"; chmod 600 "$file"; }
    ENV_SET_KEY="$key" ENV_SET_VALUE="$value" awk '
        BEGIN { done = 0; key = ENVIRON["ENV_SET_KEY"]; value = ENVIRON["ENV_SET_VALUE"] }
        index($0, key "=") == 1 { if (!done) { print key "=" value; done = 1 }; next }
        { print }
        END { if (!done) print key "=" value }
    ' "$file" >"$tmp"
    cat "$tmp" >"$file"
    rm -f "$tmp"
}

confirm() { # "Question" default(y|n)
    local q=$1 d=${2:-y} a hint
    [ "$d" = y ] && hint="Y/n" || hint="y/N"
    printf '%s [%s] ' "$q" "$hint"
    IFS= read -r a || a=""
    [ -z "$a" ] && a=$d
    case "$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]')" in
        y|yes|д|да) return 0 ;;
        *) return 1 ;;
    esac
}

# The drop-in directory is created on demand (an installation made before it
# existed has none) and carries the note explaining what it is for.
ensure_dropin_dir() {
    mkdir -p "$IMPI_HOME/$COMPOSE_DROPIN_DIR"
    [ -f "$IMPI_HOME/$COMPOSE_DROPIN_DIR/README.md" ] \
        || cp "$REPO/installer/dropin-README.md" \
              "$IMPI_HOME/$COMPOSE_DROPIN_DIR/README.md" 2>/dev/null || true
}

# Installations made before the mode was recorded stored the DERIVED file list
# in IMPI_COMPOSE_FILES. Read the mode back out of it once, and — if a human had
# added files of their own to that list — say where they belong now, because
# nothing reads that key any more.
migrate_compose_env() {
    [ -n "${IMPI_MM_MODE:-}" ] && return 0
    [ -n "${IMPI_COMPOSE_FILES:-}" ] || return 0
    IMPI_MM_MODE=$(infer_mode_from_files "$IMPI_COMPOSE_FILES")
    IMPI_COMPOSE_ROOTLESS=0
    case " $IMPI_COMPOSE_FILES " in *compose.podman.yaml*) IMPI_COMPOSE_ROOTLESS=1 ;; esac
    env_set IMPI_MM_MODE "$IMPI_MM_MODE" "$IMPI_HOME/compose.env"
    env_set IMPI_COMPOSE_ROOTLESS "$IMPI_COMPOSE_ROOTLESS" "$IMPI_HOME/compose.env"
    ok "compose.env: recorded IMPI_MM_MODE=$IMPI_MM_MODE (the file list is derived now)"

    local _f _from _extra=""
    for _f in $IMPI_COMPOSE_FILES; do
        case "$_f" in
            deploy/compose.yaml|deploy/compose.mattermost.yaml) continue ;;
            deploy/compose.external-mm.yaml|deploy/compose.podman.yaml) continue ;;
        esac
        _extra="$_extra $_f"
    done
    [ -n "$_extra" ] || return 0
    ensure_dropin_dir
    bad "compose.env: these files are no longer read from IMPI_COMPOSE_FILES:"
    for _f in $_extra; do printf '    %s\n' "$_f" >&2; done
    printf '  move them to %s/ — everything *.yaml there is merged automatically:\n' \
        "$IMPI_HOME/$COMPOSE_DROPIN_DIR" >&2
    for _f in $_extra; do
        case "$_f" in
            /*)   _from=$_f ;;
            ../*) _from="$IMPI_HOME/${_f#../}" ;;   # entries were repo-relative
            *)    _from="$REPO/$_f" ;;
        esac
        printf '    mv %s %s/\n' "$_from" "$IMPI_HOME/$COMPOSE_DROPIN_DIR" >&2
    done
}

usage() {
    cat <<'EOF'
impi — manage your impi deployment

  impi status              services + installed version
  impi logs [-f] [SVC]     engine (or SVC) logs
  impi start | stop        bring the stack up / stop it
  impi restart             restart the engine (picks up .env + new agents)
  impi reload              re-read agent profiles in place (skills, tools, prompts)
  impi skill list|install|assign ...   the shared skill library
  impi task list|show|runs|add|rm|pause|resume|run-now|status
                           scheduled and recurring work
  impi sessions list|delete|purge-idle   conversation memory
  impi ward init|unlock|status|set|ls|rm|policy|grants|revoke|rotate|audit|cert
                           the secret broker (see docs/secrets.md)
  impi ward unlock --from ~/.impi/ward-recovery.txt   open it without typing keys
  impi agent add|list ...  manage agents (runs the CLI inside the container)
  impi agent sync          give every agent a container of its own, and start it
  impi agent migrate AGENT move an agent's sessions/files into its own volumes
  impi agent logs|shell AGENT   that agent's container
  impi login               interactive pi model login inside the container
  impi login --copy-auth [FILE]   import pi credentials (default ~/.pi/agent/auth.json)
  impi update [--yes]      update to the newest release tag and rebuild
  impi doctor              basic health checks (and your compose overlays)
  impi uninstall           stop and remove containers (keeps your data)
  impi version             wrapper / repo version
EOF
}

cmd_status() {
    compose ps
    printf 'installed: %s (repo %s)\n' "${IMPI_VERSION_INSTALLED:-?}" \
        "v$(cat "$REPO/VERSION" 2>/dev/null || echo '?')"
}

cmd_logs() {
    if [ $# -gt 0 ] && [ "$1" != -f ]; then
        compose logs "$@"
    else
        compose logs "$@" impi
    fi
}

# Build what this deployment builds from source. The list comes from the shared
# library, so an update rebuilds the broker too when there is one.
build_images() {
    # shellcheck disable=SC2046  # a list of services is meant to split
    compose build $(build_services)
}

cmd_restart() {
    compose restart impi
    ok "engine restarted"
}

# Re-read the agent profiles without dropping the process: SIGHUP is what the
# engine listens for, and live conversations keep their memory.
cmd_reload() {
    compose kill -s HUP impi
    ok "profiles reloaded (agents pick them up on their next turn)"
}

# Where the material `ward init` produces is kept: on the HOST, outside every
# bind mount, so no container — and no agent — can read it.
WARD_RECOVERY="$IMPI_HOME/ward-recovery.txt"

# After a restart the store is sealed again, and nothing about a running stack
# says so — the first sign is an agent refused with "not available right now".
# Printed where it is actionable (right after bringing the stack up) rather than
# by querying on every `impi status`, which would make the fast command slow for
# a fact that only changes when the broker restarts.
ward_reminder() {
    [ "${IMPI_VAULT:-0}" = 1 ] || return 0
    if [ -r "$WARD_RECOVERY" ]; then
        printf 'the secret store is sealed after a restart:\n  impi ward unlock --from %s\n' \
            "$WARD_RECOVERY"
    else
        printf 'the secret store is sealed after a restart: impi ward unlock\n'
    fi
}

cmd_ward() {
    case "${1:-}" in
        init) shift; cmd_ward_init "$@" ;;
        # `unlock --from` is served here rather than in the container: the file
        # lives on the host precisely so nothing mounts it, so the wrapper reads
        # it and pipes it in.
        unlock)
            shift
            _src=""
            case "${1:-}" in
                --from) _src=${2:-}; shift 2 ;;
                --from=*) _src=${1#--from=}; shift ;;
            esac
            if [ -n "$_src" ]; then
                [ -r "$_src" ] || die "cannot read $_src"
                compose run --rm -T ward-admin ward-admin unlock "$@" <"$_src"
            else
                compose run --rm ward-admin ward-admin unlock "$@"
            fi ;;
        *) compose run --rm ward-admin ward-admin "$@" ;;
    esac
}

# The one-time ceremony. `run`, not `exec`: on a first install the broker has no
# certificate authority yet and restarts in a loop, so there is no running
# container to exec into — the chicken-and-egg an operator hits exactly once,
# when they are least able to tell a bug from their own mistake.
#
# The material never reaches a terminal. --machine puts it on stdout as
# KEY=VALUE, the wrapper captures that into a 600 file on the host, and prints
# the path. What a printed credential does is live in scrollback, in a screen
# share, and in the transcript of whatever ran the command.
cmd_ward_init() {
    [ -e "$WARD_RECOVERY" ] && [ "${1:-}" != --force ] \
        && die "$WARD_RECOVERY already exists — this deployment has been initialised"
    _tmp="$WARD_RECOVERY.tmp.$$"
    (umask 077; : >"$_tmp") || die "cannot write beside $WARD_RECOVERY"
    if ! compose run --rm -T ward ward init --machine "$@" >"$_tmp.raw"; then
        rm -f "$_tmp" "$_tmp.raw"
        die "ward init failed — see the output above"
    fi
    # Only the material. Compose runtimes write their own progress to stdout,
    # and the file this becomes is one an operator will paste into a password
    # manager — a container id in the middle of it invites deleting the wrong
    # line. Anything unexpected is dropped here rather than stored.
    grep -E '^WARD_[A-Z_]+=' "$_tmp.raw" >"$_tmp" || true
    rm -f "$_tmp.raw"
    if ! grep -q '^WARD_UNSEAL_KEY=' "$_tmp" || ! grep -q '^WARD_SECRET_ID=' "$_tmp"; then
        rm -f "$_tmp"
        die "ward init produced no recovery material — see the output above"
    fi
    mv "$_tmp" "$WARD_RECOVERY"
    chmod 600 "$WARD_RECOVERY"
    ok "the store is initialised"
    ok "recovery material: $WARD_RECOVERY (chmod 600, mounted into nothing)"
    # The role id is not a credential and the broker needs it in its own env;
    # copying it by hand was a step that existed only to be forgotten.
    _role=$(grep '^WARD_ROLE_ID=' "$WARD_RECOVERY" | cut -d= -f2-)
    if [ -n "$_role" ]; then
        env_set WARD_ROLE_ID "$_role" "$IMPI_HOME/conf/ward.env"
        ok "WARD_ROLE_ID written to conf/ward.env"
    fi
    printf '\n'
    printf 'Put %s in your password manager, then:\n' "$(basename "$WARD_RECOVERY")"
    printf '  impi start                       # the broker picks up its role id\n'
    printf '  impi ward unlock --from %s\n' "$WARD_RECOVERY"
    printf '  impi ward cert <agent>           # an identity per agent\n'
}

# Which container runtime is under the compose command. Needed for the one
# build compose cannot order for us — see cmd_agent_sync.
container_runtime() {
    case "$IMPI_COMPOSE_CMD" in
        podman*) printf 'podman\n' ;;
        *) printf 'docker\n' ;;
    esac
}

agent_containers_on() { [ "${IMPI_AGENT_CONTAINERS:-0}" = 1 ]; }

# Work out what each agent's container needs, build the images, and bring them
# up. The engine writes the description (it is what reads the profiles) into the
# mounted conf directory; everything after that is a build and an up.
#
# This is the step that replaces "the engine created the agent and it just
# started answering": creating an agent now writes a profile, and a container is
# something a person on this machine brings into being.
cmd_agent_sync() {
    agent_containers_on || die "per-agent containers are off — put IMPI_AGENT_CONTAINERS=1 in $IMPI_HOME/compose.env first"
    local _args="" _runtime
    [ "${IMPI_VAULT:-0}" = 1 ] && _args="$_args --with-vault"
    [ "${IMPI_BROWSER:-0}" = 1 ] && _args="$_args --with-browser"
    # Without this the agents' containers get a different user mapping from the
    # engine's, and the volumes they share have two different owners.
    [ "${IMPI_COMPOSE_ROOTLESS:-0}" = 1 ] && _args="$_args --rootless"
    # shellcheck disable=SC2086  # the flags are meant to split
    compose run --rm impi impi agent render $_args \
        || die "could not work out what the agents need"
    _runtime=$(container_runtime)
    printf 'building the shared agent image (the slow one — every agent is built on it)\n'
    "$_runtime" build -f "$REPO/deploy/Dockerfile.agent" \
        --build-arg "IMPI_UID=${IMPI_UID:-1000}" \
        --build-arg "IMPI_GID=${IMPI_GID:-1000}" \
        -t localhost/impi-agent:local "$REPO" \
        || die "the shared agent image did not build"
    build_images
    compose up -d
    ok "each agent is running in a container of its own"
    printf 'logs for one of them: impi agent logs <agent>\n'
}

# Move what an agent already has into the volumes its own container will mount.
# Run ONCE, before the first sync: session files are the memory of every
# conversation that agent has had, and leaving them behind looks exactly like
# an agent that has forgotten everybody.
cmd_agent_migrate() {
    local _agent=${1:-} _moved=0 _failed=0 _project="${IMPI_PROJECT:-impi}"
    [ -n "$_agent" ] || die "usage: impi agent migrate <agent>"
    agent_containers_on || die "per-agent containers are off — nothing to migrate into"
    [ -f "$IMPI_HOME/conf/agents.compose.yaml" ] \
        || die "run 'impi agent render' or 'impi agent sync' first — the volumes are named there"
    # stderr silenced on the PROBES only: a missing directory is the ordinary
    # answer here, and compose reports a non-zero exit as an error of its own —
    # which reads as a failed migration in the middle of a successful one.
    _failed=0
    if compose run --rm -T impi test -d "/app/data/pi-sessions/$_agent" 2>/dev/null; then
        migrate_volume "$_agent" "${_project}_agent-$_agent-sessions" \
            "/app/data/pi-sessions/$_agent" "session files" || _failed=1
        _moved=1
    fi
    if compose run --rm -T impi test -d "/app/data/attachments/$_agent" 2>/dev/null; then
        migrate_volume "$_agent" "${_project}_agent-$_agent-files" \
            "/app/data/attachments/$_agent" "attachments" || _failed=1
        _moved=1
    fi
    [ "$_moved" = 1 ] || printf '%s had nothing to move\n' "$_agent"
    if [ "$_failed" = 1 ]; then
        die "$_agent was NOT migrated. Do not run \`impi agent sync\` yet: its container would start on an empty volume and the agent would answer as if it had forgotten every conversation."
    fi
    printf 'the originals are left in place; remove them once the agent answers normally\n'
}

cmd_agent() {
    case "${1:-}" in
        sync)    shift; cmd_agent_sync "$@"; return ;;
        migrate) shift; cmd_agent_migrate "$@"; return ;;
        logs)
            shift
            [ -n "${1:-}" ] || die "usage: impi agent logs <agent>"
            compose logs "agent-$1"
            return
            ;;
        shell)
            shift
            [ -n "${1:-}" ] || die "usage: impi agent shell <agent>"
            compose exec "agent-$1" bash
            return
            ;;
    esac
    compose run --rm impi impi agent "$@"
    if [ "${1:-}" = add ]; then
        if agent_containers_on; then
            printf 'the profile is written; give it a container: impi agent sync\n'
        elif confirm "Restart the engine now so the new agent starts?" y; then
            cmd_restart
        fi
    fi
}

cmd_login() {
    if [ "${1:-}" = --copy-auth ]; then
        local src="${2:-$HOME/.pi/agent/auth.json}"
        [ -s "$src" ] || die "no credentials at $src"
        compose run --rm -T impi sh -c \
            'mkdir -p ~/.pi/agent && cat > ~/.pi/agent/auth.json && chmod 600 ~/.pi/agent/auth.json' <"$src"
        ok "pi credentials imported"
        return
    fi
    printf 'Opening pi inside the container. Type /login, follow the flow, then exit.\n'
    # 1455: the openai-codex OAuth flow runs a fixed localhost callback server
    # inside the container; the browser lives on the host.
    compose run --rm -p 1455:1455 impi pi || true
    if compose run --rm -T impi test -s /home/impi/.pi/agent/auth.json >/dev/null 2>&1; then
        ok "pi credentials saved"
    else
        bad "still no credentials — try again or use: impi login --copy-auth"
    fi
}

cmd_update() {
    local yes=0 latest current prev
    [ "${1:-}" = --yes ] && yes=1
    git -C "$REPO" fetch --tags --quiet origin
    latest=$(git -C "$REPO" tag -l 'v*' | sort -V | tail -n 1)
    current="v$(cat "$REPO/VERSION" 2>/dev/null || echo 0.0.0)"
    [ -n "$latest" ] || die "no release tags in the repository yet"
    if [ "$latest" = "$current" ]; then
        ok "up to date ($current)"
        return 0
    fi
    printf 'Update available: %s -> %s\n' "$current" "$latest"
    # Prefer the curated release notes for the target version; fall back to the
    # raw commit list when the tag predates CHANGELOG.md.
    notes=$(git -C "$REPO" show "$latest:CHANGELOG.md" 2>/dev/null \
        | awk -v ver="$latest" 'index($0, "## " ver) == 1 {f=1; next} /^## /{f=0} f')
    if [ -n "$notes" ]; then
        printf '%s\n' "$notes" | sed 's/^/  /'
    else
        git -C "$REPO" log --oneline "$current".."$latest" 2>/dev/null | sed 's/^/  /' || true
    fi
    if [ "$yes" != 1 ]; then
        confirm "Update now?" y || return 0
    fi
    [ -z "$(git -C "$REPO" status --porcelain)" ] \
        || die "repo at $REPO has local changes — commit/stash them or reinstall"
    prev=$current
    git -C "$REPO" checkout --quiet "$latest"
    # Nothing to rewrite here: the engine's file list is derived from
    # IMPI_MM_MODE on every call, so overlays added by this release apply at
    # once — and whatever is in compose.d/ is untouched, because it was never
    # part of a list anyone regenerates.
    if ! build_images || ! compose up -d; then
        bad "update failed"
        if confirm "Roll back to $prev?" y; then
            git -C "$REPO" checkout --quiet "$prev"
            build_images && compose up -d
            die "rolled back to $prev"
        fi
        exit 1
    fi
    i=0
    while [ "$i" -lt 30 ]; do
        if engine_logged "app built:"; then break; fi
        sleep 2
        i=$((i + 1))
    done
    if [ "$i" -ge 30 ]; then
        bad "engine did not report readiness after the update — check \`impi logs\`"
        if confirm "Roll back to $prev?" n; then
            git -C "$REPO" checkout --quiet "$prev"
            build_images && compose up -d
            die "rolled back to $prev"
        fi
    fi
    ward_reminder
    ensure_dropin_dir
    # By rename, not in place: this script is the file being replaced, and bash
    # is still reading it (see install_executable).
    install_executable "$REPO/installer/bin/impi" "$HOME/.local/bin/impi"
    env_set IMPI_VERSION_INSTALLED "$latest" "$IMPI_HOME/compose.env"
    ok "updated to $latest"
}

cmd_doctor() {
    compose ps || true
    # What is layered on top of the engine's own files — the first thing to know
    # when a deployment behaves unlike a stock one.
    _dropins=$(ls "$IMPI_HOME/$COMPOSE_DROPIN_DIR"/*.yaml 2>/dev/null || true)
    if [ -n "$_dropins" ]; then
        ok "compose overlays: $(printf '%s' "$_dropins" | tr '\n' ' ')"
    else
        ok "compose overlays: none ($IMPI_HOME/$COMPOSE_DROPIN_DIR is empty)"
    fi
    if [ -f "$IMPI_HOME/conf/.env" ]; then
        perms=$(stat -c '%a' "$IMPI_HOME/conf/.env" 2>/dev/null || stat -f '%Lp' "$IMPI_HOME/conf/.env" 2>/dev/null)
        if [ "$perms" = 600 ]; then
            ok "conf/.env permissions: 600"
        else
            bad "conf/.env permissions: ${perms:-?} (expected 600)"
        fi
    else
        bad "missing $IMPI_HOME/conf/.env"
    fi
    if engine_logged "app built:"; then
        ok "engine reported readiness (app built)"
    else
        bad "engine never logged 'app built:' — see \`impi logs\`"
    fi
    # The scheduler's own verdict: an idle ticker and a dead one look the same
    # from outside, so it is asked rather than guessed at.
    compose run --rm -T impi impi task status || true
    compose run --rm -T impi impi health || true
    # Which inventory the engine actually reached. Worth asking rather than
    # reading back from compose.env: a settings key that did not arrive leaves
    # the engine on SQLite, and a SQLite file it can open is indistinguishable
    # from a working deployment until somebody notices the tasks are missing.
    # shellcheck disable=SC2016  # the body is Python, not shell.
    compose run --rm -T impi python3 -c '
import asyncio
from crucible.store import open_store
from impi.config import load_settings

settings = load_settings()
backend = settings.store_backend
name = settings.resolved_db_name
# Kept as two things rather than glued into one URI: a connection string may
# already carry a query, and appending a database name after it prints
# something that is not an address anybody could use.
where = f"{name} at {settings.db_url}" if settings.db_url else name


async def main():
    store = open_store(backend, name=name, url=settings.db_url)
    try:
        await store.list_agents()
    finally:
        await store.close()


try:
    asyncio.run(main())
except Exception as exc:
    print(f"\u2718 inventory: {backend} \u2014 {where} did not answer: {exc}")
else:
    print(f"\u2714 inventory: {backend} \u2014 {where}")
' || true
    # The store, when there is one: locked and open look identical from outside,
    # and a locked store refuses every agent until somebody unlocks it.
    [ "${IMPI_VAULT:-0}" = 1 ] && { compose run --rm -T ward-admin ward-admin status || true; }
    # The browser, when there is one. This walks the whole path an agent walks —
    # engine container, the browser network, the relay, Chrome — and reports what
    # Chrome says it is. Probing the relay alone would only prove the half that
    # does not break. httpx rather than curl: the engine's image has no curl.
    if [ "${IMPI_BROWSER:-0}" = 1 ]; then
        # shellcheck disable=SC2016  # the body is Python, not shell: nothing in
        # it is meant to expand here, and the backticks are message text.
        compose run --rm -T impi python3 -c '
import os, sys, httpx
url = os.environ.get("BROWSER_CDP_URL")
if not url:
    print("\u2718 browser: BROWSER_CDP_URL is unset — the overlay did not merge")
    sys.exit(0)
try:
    info = httpx.get(f"{url}/json/version", timeout=20).json()
except Exception as exc:
    print(f"\u2718 browser: no answer at {url} ({type(exc).__name__}) — see `impi logs browser`")
    sys.exit(0)
name = info.get("Browser", "?")
print(f"\u2714 browser: {name} at {url}")
'  || true
    fi
    # The agents' own containers, when they have them. Two things go wrong here
    # and neither is visible from `compose ps`: an agent whose profile exists but
    # whose container was never synced (it silently runs in the engine instead),
    # and a compose.d override that was written for the engine service and now
    # misses the agents entirely.
    if agent_containers_on; then
        if [ -f "$IMPI_HOME/conf/agents.compose.yaml" ]; then
            _rendered=""
            for _d in "$IMPI_HOME"/conf/agents/*/; do
                [ -f "$_d/Dockerfile" ] && _rendered="$_rendered $(basename "$_d")"
            done
            ok "agent containers:${_rendered:- none rendered}"
        else
            bad "agent containers are on but nothing is rendered — run \`impi agent sync\`"
        fi
        compose run --rm -T impi impi agent list || true
        if [ -n "$_dropins" ]; then
            printf 'note: overrides in %s apply to the services they name. Anything\n' \
                "$IMPI_HOME/$COMPOSE_DROPIN_DIR"
            printf '      you added for the engine does NOT reach the agents any more.\n'
        fi
    fi
    return 0
}

cmd_uninstall() {
    confirm "Stop and remove the impi containers?" n || exit 0
    compose down
    if confirm "ALSO delete the data volumes (engine DB, pi credentials, Mattermost data)?" n; then
        compose down -v
    fi
    rm -f "$HOME/.local/bin/impi"
    ok "uninstalled. $IMPI_HOME (config, agents, repo) was kept — remove it manually if you are sure."
}

migrate_compose_env

case "${1:-}" in
    status)    shift; cmd_status "$@" ;;
    logs)      shift; cmd_logs "$@" ;;
    start)     shift; compose up -d; ok "started"; ward_reminder ;;
    stop)      shift; compose stop; ok "stopped" ;;
    restart)   shift; cmd_restart ;;
    reload)    shift; cmd_reload ;;
    skill)     shift; compose run --rm impi impi skill "$@" ;;
    task)      shift; compose run --rm impi impi task "$@" ;;
    sessions)  shift; compose run --rm impi impi sessions "$@" ;;
    # `init` is the broker's own one-time ceremony and belongs inside its
    # container. Every other verb is `ward-admin`, the secret tool's operator
    # CLI: it runs in the engine's container because that is where the operator
    # certificate is mounted, and reaches the broker over the network like any
    # other client. WARD_ADMIN_PROG only affects the hints it prints — they
    # should say what the operator actually typed.
    ward)      shift; cmd_ward "$@" ;;
    agent)     shift; cmd_agent "$@" ;;
    login)     shift; cmd_login "$@" ;;
    update)    shift; cmd_update "$@" ;;
    doctor)    shift; cmd_doctor ;;
    uninstall) shift; cmd_uninstall ;;
    version)   printf 'impi %s (%s)\n' "${IMPI_VERSION_INSTALLED:-?}" "$IMPI_HOME" ;;
    ''|help|-h|--help) usage ;;
    *) bad "unknown command: $1"; usage; exit 2 ;;
esac
